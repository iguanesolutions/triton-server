{
    "name": "Triton server - OpenAI Frontend",
    "image": "nvcr.io/nvidia/tritonserver:24.11-py3",
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
                "ms-python.python"
            ]
        }
